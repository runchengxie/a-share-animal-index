# Copy to .env and replace the placeholder before running the scripts.
TUSHARE_TOKEN="replace-with-your-tushare-pro-token"
TUSHARE_TOKEN_2="replace-with-your-second-tushare-pro-token"
# Optional name audit providers. They never affect zoo-index output.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
ZOO_AUDIT_GEMINI_MODEL="gemini-2.5-flash"
# Set a pinned OpenRouter free model; openrouter/free is used after it.
ZOO_AUDIT_OPENROUTER_MODEL=""
