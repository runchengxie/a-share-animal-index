# 复制为 .envrc 并允许 direnv 加载本地密钥（需要 direnv：https://direnv.net）。

# 加载 .env 文件中的环境变量（如存在）。
dotenv_if_exists .env
dotenv_if_exists .env.local

has_cmd() { command -v "$1" >/dev/null 2>&1; }

# 确保虚拟环境存在并安装依赖（含 dev 组）。
ensure_venv() {
  if [ ! -d .venv ]; then
    uv venv --seed || return 1
  fi
  # shellcheck disable=SC1091
  source .venv/bin/activate
  uv sync
}

if has_cmd uv; then
  ensure_venv || echo "warning: uv 环境准备失败" >&2
else
  echo "notice: 未检测到 uv，请先安装 uv 后再进入开发环境" >&2
fi
